        "test_enemy_action_test3" : "Test3",
        "test_enemy_action_test4" : "Test4",
        "test_enemy_action_test5" : "Test5",
        "test_enemy_action_test6" : "Test6",
        "test_enemy_action1.1" : "This is a test enemy.",
        "test_enemy_action1.2" : "It has very high HP.",
        "test_enemy_action_dial1.1" : "Test enemy is testing localization.",
        "test_enemy_action2.1" : "Test enemy looks confused.",
