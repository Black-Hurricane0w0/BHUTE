        "basic_enemy_name" : "Basic Enemy",
        "basic_enemy_action_check" : "Check",
        "basic_enemy_action_fuck" : "Attack",
        "basic_enemy_action_eat" : "Eat",
        "basic_enemy_action_sleep" : "Sleep",
