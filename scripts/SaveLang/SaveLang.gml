        "ui.phase_2" : "第二阶段",
        "ui.phase_3" : "最终阶段",
        "ui.badend_dialogue_1" : "别失去希望!",
        "ui.badend_dialogue_2" : "保持你的决心...",
        "ui.first_phase" : "第一阶段",
        "ui.second_phase" : "第二阶段",
        "ui.final_phase" : "最终阶段",
        "battle_dialogue" : "你好",
        "basic_enemy_action1.1" : "基础敌人 1攻击 0防御",
