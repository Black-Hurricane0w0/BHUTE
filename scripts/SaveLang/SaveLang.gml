        "basic_enemy_action4.2" : "真糟糕！",
        "basic_enemy_action4.3" : "哦，你被惊醒了！",
        "test_enemy_name" : "测试敌人",
        "test_enemy_action_check" : "检查",
        "test_enemy_action_test1" : "测试1",
        "test_enemy_action_test2" : "测试2",
        "test_enemy_action_test3" : "测试3",
        "test_enemy_action_test4" : "测试4",
        "test_enemy_action_test5" : "测试5",
        "test_enemy_action_test6" : "测试6",
        "test_enemy_action1.1" : "这是一个测试敌人。",
        "test_enemy_action1.2" : "它有很高的生命值。",
        "test_enemy_action_dial1.1" : "测试敌人正在测试本地化功能。",
        "test_enemy_action2.1" : "测试敌人看起来很困惑。",
        "test_enemy_action3.1" : "^^^^  &^&^^",
        "basic_enemy_name" : "基础敌人",
        "basic_enemy_action_check" : "检查",
        "basic_enemy_action_fuck" : "攻击",
        "basic_enemy_action_eat" : "进食",
        "basic_enemy_action_sleep" : "睡眠",
        "basic_enemy_action1.1" : "基础敌人看起来很普通。",
        "basic_enemy_action1.2" : "它的攻击力不高。",
        "basic_enemy_action2.1" : "基础敌人向你发起了攻击！",
        "basic_enemy_action3.1" : "基础敌人正在吃东西。",
        "basic_enemy_action4.1" : "基础敌人睡着了。",
        "basic_enemy_action4.2" : "它看起来很安详。",
        "basic_enemy_action4.3" : "也许你可以饶恕它。"
