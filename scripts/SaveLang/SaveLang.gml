        "basic_enemy_action1.2" : "Its attack power is low.",
        "basic_enemy_action2.1" : "Basic enemy attacks you!",
        "basic_enemy_action3.1" : "Basic enemy is eating.",
        "basic_enemy_action4.1" : "Basic enemy is sleeping.",
        "basic_enemy_action4.2" : "It looks peaceful.",
        "basic_enemy_action4.3" : "Maybe you can spare it."
    };
    var entxt = file_text_open_write("en.json");
    file_text_write_string(entxt,json_stringify(en))
    file_text_close(entxt);
    
    var zh = {
        "language" : "zh",
        "language_name" : "简体中文",
