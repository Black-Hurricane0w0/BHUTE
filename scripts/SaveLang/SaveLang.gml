/// @desc 保存语言文件，可在此处写入翻译，仅在debug模式下运行
function SaveLang(){
    if obj_set.debug == false exit;
    var en = {
        "language" : "en",
        "language_name" : "English",
        "font" : fnt_mono,
        "size" : 1,
        "ui.start_game" : "Start game",
